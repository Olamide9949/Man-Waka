<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/admin-style.css">
    <title>Dashboard</title>
</head>
<body>
    <header>
        <div class="Top-bar">
            <div class="col-topbar-left">
                <img src="" alt="Man Waka Logo"/>
            </div>
            <div class="topbar-horizontal-spacer"></div>
            <div class="col-topbar-right">
                <input type="search" name="search" placeholder="search..." id=""/>
                <img src="/icons/bell.png" alt="notification" />
                <img src="/icons/email.png" alt="messages" />
                <div class="Avatar">
                    <img src="/icons/user.png" alt="profile"/>
                    <h3>Olamide Tosin
                    <span>
                        <img src="/icons/down-arrow.png" alt="more" />
                    </span>
                    </h3>
                    <i>
                        <img src="/icons/ellipsis.png" alt="options menu" />
                    </i>
                </div>
            </div>
        </div>
        <nav>
            <ul>
                <li><img src="/icons/dashboard.png" alt="dashboard" /> Dashboard</li>
                <li><img src="/icons/construction-worker.png" alt="artisan" /> Artisans</li>
                <li><img src="/icons/wallet.png" alt="payment" /> Payments</li>
                <li><img src="/icons/gear.png" alt="settings" /> Settings</li>
                <li><img src="/icons/add-user.png" alt="referral" /> Referral System</li>
                <li><img src="/icons/badge.png" alt="promos" /> Promo Code</li>
                <li><img src="/icons/statistics-o.png" alt="reports" /> Reports</li>
            </ul>
        </nav>
    </header>
    <div class="main-content">
        <div class="dashboard-header">
        <div class="dashboard-counter">
            <div class="booked-job-card">
                <div>
                    <p>Running Jobs</p>
                    <h1>450</h1>
                </div>
                <div>
                    <p><img src="/icons/direction-p.png" alt="linked out" /></p>
                    <img src="/icons/shoemaker.png" alt="artisan" />
                </div>
            </div>

            <div class="cancelled-job-card">
                <div>
                    <p>Cancelled Jobs</p>
                    <h1>10</h1>
                </div>
                <div>
                    <p><img src="/icons/direction-g.png" alt="linked out" /></p>
                    <img src="/icons/fail.png" alt="cancelled jobs" />
                </div>
            </div>

            <div class="new-user-card">
                <div>
                    <p>New Users</p>
                    <h1>1000+</h1>
                </div>
                <div>
                    <p><img src="/icons/direction-or.png" alt="linked out" /></p>
                    <img src="/icons/add-user-c.png" alt="new users" />
                </div>
            </div>

            <div class="total-earnings-card">
                <div>
                    <p>Total Earnings</p>
                    <b><h1>13,468,355 <img src="/icons/ngn.png" alt="nigerian naira" /></h1></b>
                </div>
                
                <div>
                    <p><img src="/icons/direction.png" alt="linked out" /></p>
                    <img src="/icons/statistics.png" alt="reports" />
                </div>
            </div>
        </div>
        <div class="map-body">
        <iframe src="https://www.google.com/maps/embed?pb=!1m10!1m8!1m3!1d63420.65548807188!2d3.236369405761486!3d6.548056829473163!3m2!1i1024!2i768!4f13.1!5e0!3m2!1sen!2sng!4v1606947794822!5m2!1sen!2sng" 
            {{!-- width="600" 
            height="450"  --}}
            frameborder="0" 
            style="border:0;" 
            allowfullscreen="" 
            aria-hidden="false" 
            tabindex="0">
        </iframe>
            <aside>
                <span>
                <h2>Artisans</h2>
                <img src="/icons/direction-or.png" alt="linked out" />
                </span>
                <hr />
                <div>
                    <p>
                    <img src="/icons/user.png" alt="profile" />
                    Olamide Tosin
                    <span>View Details</span>
                    </p>
                    <img src="/icons/ellipsis.png" alt="more options"/>
                </div>
            </aside>    
        </div>
        </div>
    </div>
    <footer>
        <p>developed by <a href="mailto:larrytosn@gmail.com">OlaTheProgrammer</a></p>
    </footer>
</body>
</html>